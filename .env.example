# Copy to .env (cp .env.example .env) and fill in. .env is in .gitignore — never commit it.

# Required: LinkedIn posts of competitors (harvestapi.io -> Dashboard -> API key)
HARVESTAPI_KEY=

# Required: Jev, the model that judges every post (openrouter.ai -> Keys). $5 of credit lasts many hunts.
OPENROUTER_API_KEY=

# Optional: Instagram competitors (apify.com -> Settings -> API & Integrations). Without it Instagram is skipped.
APIFY_API_TOKEN=

# Optional: YouTube competitors. Without a key the app falls back to yt-dlp if it is installed (brew install yt-dlp).
YOUTUBE_DATA_API_KEY=
